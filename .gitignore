# ---- Byte-compiled / cache
__pycache__/
*.pyc
*.pyo
*.pyd

# ---- Virtual environments
.venv/
venv/
env/

# ---- OS / file manager junk
.DS_Store
Thumbs.db
desktop.ini

# ---- IDE configs
.vscode/
.idea/

# ---- Pytest / coverage
.coverage
.pytest_cache/
htmlcov/

# Keep docs and placeholders
!assets/docs/**
!assets/README_assets.md
!assets/**/.keep

# Python packaging / build artifacts
*.egg-info/

# Third-party sprites (kept out of repo; bundled in release builds)
assets/images/sprites/samurai_sprites/*.png
assets/images/sprites/enemy_sprites/*.png

